#7919 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#7920 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#7921 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#7918,
  'distance_accuracy_value','confusion accuracy');
#7922 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
