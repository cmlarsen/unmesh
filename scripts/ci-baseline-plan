#!/usr/bin/env -S uv run python
"""Pick the main smoke baseline for the PR compare gate, verify it, download it.

Exit 0 with the baseline at --out, or exit 0 having downloaded nothing when the
gate must be skipped (compare not on main yet, or no main run yet). Exit 1 when
a baseline should exist but cannot be trusted or downloaded.
"""

from __future__ import annotations

import argparse
import json
import subprocess
import sys
import tempfile
from dataclasses import dataclass
from pathlib import Path

COMPARE_MODULE = Path("harness/src/unmesh_harness/runner/compare.py")


@dataclass(frozen=True)
class BaselineRun:
    id: int
    event: str
    head_branch: str
    head_sha: str
    head_repo: str
    fork: bool


@dataclass(frozen=True)
class BaselineDecision:
    action: str  # "use" | "skip" | "fail"
    run_id: int | None
    message: str
    fell_back: bool = False


def _trusted(run: BaselineRun | None, repo: str) -> bool:
    return (
        run is not None
        and run.event == "push"
        and run.head_branch == "main"
        and run.head_repo == repo
        and not run.fork
    )


def decide_baseline(
    *,
    repo: str,
    base_sha: str,
    base: BaselineRun | None,
    latest: BaselineRun | None,
    compare_on_main: bool,
) -> BaselineDecision:
    if not compare_on_main:
        return BaselineDecision("skip", None, "compare not on main yet; skipping regression gate")
    if base is not None and _trusted(base, repo) and base.head_sha == base_sha:
        return BaselineDecision("use", base.id, f"baseline is main run {base.id}")
    if _trusted(latest, repo):
        assert latest is not None
        return BaselineDecision(
            "use",
            latest.id,
            f"no successful main run for base sha {base_sha}, "
            f"falling back to latest main run {latest.id} ({latest.head_sha})",
            fell_back=True,
        )
    if base is None and latest is None:
        return BaselineDecision("skip", None, "no successful main run yet, skipping compare")
    return BaselineDecision(
        "fail",
        None,
        "no trustworthy main baseline run: candidates are not push-to-main runs "
        f"of {repo} (base sha {base_sha})",
    )


def list_run_id(repo: str, workflow: str, commit: str | None) -> int | None:
    cmd = [
        "gh",
        "run",
        "list",
        "--repo",
        repo,
        "--branch",
        "main",
        "--workflow",
        workflow,
        "--event",
        "push",
        "--status",
        "success",
        "--limit",
        "1",
        "--json",
        "databaseId",
    ]
    if commit:
        cmd.extend(["--commit", commit])
    out = subprocess.run(cmd, capture_output=True, text=True, check=True)
    rows = json.loads(out.stdout)
    if rows and isinstance(rows[0].get("databaseId"), int):
        return rows[0]["databaseId"]
    return None


def run_metadata(repo: str, run_id: int) -> BaselineRun:
    out = subprocess.run(
        ["gh", "api", f"repos/{repo}/actions/runs/{run_id}"],
        capture_output=True,
        text=True,
        check=True,
    )
    payload = json.loads(out.stdout)
    head_repo = payload.get("head_repository") or {}
    return BaselineRun(
        id=int(payload["id"]),
        event=str(payload.get("event") or ""),
        head_branch=str(payload.get("head_branch") or ""),
        head_sha=str(payload.get("head_sha") or ""),
        head_repo=str(head_repo.get("full_name") or ""),
        fork=bool(head_repo.get("fork", False)),
    )


def download_artifact(repo: str, run_id: int, artifact: str, dest: Path) -> None:
    with tempfile.TemporaryDirectory(prefix="baseline-") as tmp:
        subprocess.run(
            [
                "gh",
                "run",
                "download",
                str(run_id),
                "--repo",
                repo,
                "-n",
                artifact,
                "-D",
                tmp,
            ],
            capture_output=True,
            text=True,
            check=True,
        )
        hits = sorted(Path(tmp).glob("*.jsonl"))
        if not hits:
            raise ValueError(f"artifact {artifact!r} of run {run_id} holds no jsonl")
        dest.parent.mkdir(parents=True, exist_ok=True)
        dest.write_bytes(hits[0].read_bytes())


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--repo", required=True)
    parser.add_argument("--base-sha", required=True)
    parser.add_argument("--artifact", required=True)
    parser.add_argument("--out", type=Path, required=True)
    parser.add_argument("--main-tree", type=Path, required=True)
    parser.add_argument("--workflow", default="ci.yml")
    args = parser.parse_args()
    try:
        compare_on_main = (args.main_tree / COMPARE_MODULE).is_file()
        if not compare_on_main:
            decision = decide_baseline(
                repo=args.repo,
                base_sha=args.base_sha,
                base=None,
                latest=None,
                compare_on_main=False,
            )
            assert decision.action == "skip"
            print(f"::warning::{decision.message}")
            return 0
        base_id = list_run_id(args.repo, args.workflow, args.base_sha)
        base = run_metadata(args.repo, base_id) if base_id is not None else None
        latest_id = None
        if base is None or base.head_sha != args.base_sha:
            latest_id = list_run_id(args.repo, args.workflow, None)
        latest = run_metadata(args.repo, latest_id) if latest_id is not None else None
        decision = decide_baseline(
            repo=args.repo,
            base_sha=args.base_sha,
            base=base,
            latest=latest,
            compare_on_main=compare_on_main,
        )
        if decision.action == "skip":
            print(f"::warning::{decision.message}")
            return 0
        if decision.action == "fail":
            print(f"::error::{decision.message}")
            return 1
        assert decision.run_id is not None
        if decision.fell_back:
            print(f"::warning::{decision.message}")
        else:
            print(decision.message)
        download_artifact(args.repo, decision.run_id, args.artifact, args.out)
    except (subprocess.CalledProcessError, ValueError, KeyError) as e:
        print(f"::error::baseline artifact missing or unreadable: {e}")
        return 1
    print(f"baseline ready at {args.out}")
    return 0


if __name__ == "__main__":
    sys.exit(main())
