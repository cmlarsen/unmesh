#271739 = ( NAMED_UNIT(*) PLANE_ANGLE_UNIT() SI_UNIT($,.RADIAN.) );
#271740 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#271741 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#271738,
  'distance_accuracy_value','confusion accuracy');
#271742 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
