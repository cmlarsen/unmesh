#1864 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#1865 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#1862,
  'distance_accuracy_value','confusion accuracy');
#1866 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
