#37488 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#37489 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#37486,
  'distance_accuracy_value','confusion accuracy');
#37490 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
