#11049 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#11046,
  'distance_accuracy_value','confusion accuracy');
#11050 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
