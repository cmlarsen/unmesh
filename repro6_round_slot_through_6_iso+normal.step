#23196 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#23197 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#23194,
  'distance_accuracy_value','confusion accuracy');
#23198 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
