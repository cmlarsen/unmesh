#22025 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#22022,
  'distance_accuracy_value','confusion accuracy');
#22026 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
