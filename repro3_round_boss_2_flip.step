#20044 = ( NAMED_UNIT(*) SI_UNIT($,.STERADIAN.) SOLID_ANGLE_UNIT() );
#20045 = UNCERTAINTY_MEASURE_WITH_UNIT(LENGTH_MEASURE(1.E-07),#20042,
  'distance_accuracy_value','confusion accuracy');
#20046 = PRODUCT_TYPE('part',$,(#7));
ENDSEC;
END-ISO-10303-21;
